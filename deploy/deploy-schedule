#!/usr/bin/env bash
set -euo pipefail

root="$HOME/apps/test-russ-market"
repository="$root/repository.git"
env_file="$root/shared/.env.local"
process_name="test-russ-market-schedule"
sha="${1:-}"

if [[ $# -ne 1 || ! "$sha" =~ ^[a-f0-9]{40}$ ]]; then
  echo "Usage: deploy-schedule <commit-sha>" >&2
  exit 2
fi

export NVM_DIR="${NVM_DIR:-$HOME/.nvm}"
if [[ -s "$NVM_DIR/nvm.sh" ]]; then
  set +u
  if ! source "$NVM_DIR/nvm.sh" --no-use || ! nvm use --silent 22; then
    echo "Install Node.js 22 under the deployment account with nvm." >&2
    exit 1
  fi
  set -u
fi

for dependency in git tar node pm2 curl flock ss; do
  command -v "$dependency" >/dev/null || { echo "Missing executable: $dependency" >&2; exit 1; }
done
if command -v pnpm >/dev/null; then
  package_manager=(pnpm)
elif command -v corepack >/dev/null; then
  package_manager=(corepack pnpm)
else
  echo "Install pnpm or Corepack for the deployment account." >&2
  exit 1
fi

node -e '
  const [major, minor] = process.versions.node.split(".").map(Number);
  if (major < 22 || (major === 22 && minor < 13)) {
    console.error("Node.js 22.13 or newer is required.");
    process.exit(1);
  }
  const settings = require("node:util").parseEnv(require("node:fs").readFileSync(process.argv[1], "utf8"));
  for (const name of ["DATABASE_URL", "AUTH_SECRET", "AUTH_URL", "SCHEDULE_ADMIN_PASSWORD"]) {
    if (!settings[name]?.trim()) {
      console.error("Missing deployment setting: " + name);
      process.exit(1);
    }
  }
' "$env_file"

port=3010
if [[ -f "$root/shared/port" ]]; then
  port="$(cat "$root/shared/port")"
fi
if [[ ! "$port" =~ ^[1-9][0-9]{0,4}$ ]] || (( port > 65535 )); then
  echo "Invalid deployment port." >&2
  exit 1
fi

mkdir -p "$root/releases"
exec 9>"$root/deploy.lock"
flock 9

git --git-dir="$repository" fetch --no-tags origin refs/heads/master:refs/remotes/origin/master
git --git-dir="$repository" merge-base --is-ancestor "$sha" refs/remotes/origin/master
release="$root/releases/$sha"
previous="$(readlink "$root/current" || true)"

if [[ -n "$previous" ]]; then
  previous_sha="${previous##*/}"
  if [[ ! "$previous_sha" =~ ^[a-f0-9]{40}$ || "$previous" != "$root/releases/$previous_sha" ]]; then
    echo "Unexpected current release path." >&2
    exit 1
  fi
  if git --git-dir="$repository" merge-base --is-ancestor "$sha" "$previous_sha" && [[ "$sha" != "$previous_sha" ]]; then
    echo "A newer commit is already deployed."
    exit 0
  fi
elif [[ -e "$root/current" ]] || pm2 describe "$process_name" >/dev/null 2>&1 || [[ -n "$(ss -H -ltn "sport = :$port")" ]]; then
  echo "Initial deployment found an existing path, PM2 process or listener. Check the deployment directory and port." >&2
  exit 1
fi

staging=""
next_link="$root/.current-$$"
cleanup() {
  if [[ -n "$staging" ]]; then rm -rf -- "$staging"; fi
  rm -f -- "$next_link"
}
trap cleanup EXIT

if [[ ! -s "$release/.next/BUILD_ID" ]]; then
  staging="$(mktemp -d "$root/releases/.build-$sha.XXXXXX")"
  git --git-dir="$repository" archive "$sha" | tar -xf - -C "$staging"
  (
    cd "$staging"
    "${package_manager[@]}" install --frozen-lockfile --prod=false
    "${package_manager[@]}" build
    ln -s -- "$env_file" .env.local
  )
  mv -T -- "$staging" "$release"
  staging=""
fi

activate() {
  ln -s -- "$1" "$next_link" && mv -Tf -- "$next_link" "$root/current"
}

start_process() {
  if pm2 describe "$process_name" >/dev/null 2>&1; then
    pm2 restart "$process_name" --update-env
  else
    pm2 start "$root/bin/start-schedule" --interpreter bash --name "$process_name" --cwd "$root"
  fi
}

wait_until_ready() {
  local response
  for _ in {1..20}; do
    if response="$(curl --silent --fail --max-time 2 "http://127.0.0.1:$port/login")" &&
      [[ "$response" == *"Вход в CRM"* ]]; then
      return 0
    fi
    sleep 1
  done
  return 1
}

activate "$release"
if start_process && wait_until_ready; then
  echo "Deployed $sha on 127.0.0.1:$port."
  exit 0
fi

echo "Release $sha failed its startup check." >&2
if [[ -n "$previous" && "$previous" != "$release" ]]; then
  if activate "$previous" && start_process && wait_until_ready; then
    echo "Previous release restored." >&2
  else
    echo "Automatic rollback failed. Check PM2 logs for $process_name." >&2
  fi
elif [[ -z "$previous" ]]; then
  pm2 delete "$process_name" >/dev/null 2>&1 || true
  rm -f -- "$root/current"
fi
exit 1
